# The Isaac trees live in $ISAAC_ROOT (~/isaac), never here. This is belt and
# braces in case someone sets ISAAC_ROOT=. and wonders why git wants 50 GB.
IsaacSim/
IsaacLab/
_build/
_isaac_sim
__pycache__/
*.pyc
outputs/
logs/

# Staged by nvgfx.sh from the host NVIDIA driver: 260 MB of NVIDIA's binaries,
# pinned to this box's driver version. Re-stage, never commit.
nvgfx/
